rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSchoolAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email == 'ephcalculus@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }

    // Schools root
    match /schools/{schoolId} {
      allow read, write: if true;

      // Individual Continuous Assessment & Exam marks
      match /scores/{scoreId} {
        allow read, write: if true;
      }

      // Student records & terminal results
      match /students/{studentId} {
        allow read, write: if true;
      }

      // School Settings
      match /settings/{settingId} {
        allow read, write: if true;
      }

      // Daily snapshots & system snapshots
      match /daily_snapshots/{snapshotId} {
        allow read, write: if true;
      }

      // Teachers registry
      match /teachers/{teacherId} {
        allow read, write: if true;
      }
    }
  }
}
