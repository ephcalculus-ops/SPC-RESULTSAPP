{
  "entities": {
    "StudentScore": {
      "title": "StudentScore",
      "description": "Continuous assessment and examination scores for a student in a specific subject and term",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "className": { "type": "string", "maxLength": 64 },
        "subject": { "type": "string", "maxLength": 128 },
        "term": { "type": "string", "maxLength": 64 },
        "ca1": { "type": "number" },
        "ca2": { "type": "number" },
        "ca3": { "type": "number" },
        "ca4": { "type": "number" },
        "exam": { "type": "number" },
        "total": { "type": "number" },
        "grade": { "type": "string", "maxLength": 10 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["studentId", "className", "subject", "term", "total", "grade"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record with academic performance, terminal scores, and remarks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "learnerId": { "type": "string", "maxLength": 64 },
        "className": { "type": "string", "maxLength": 64 },
        "gender": { "type": "string", "maxLength": 16 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "learnerId", "className"]
    },
    "SchoolSetting": {
      "title": "SchoolSetting",
      "description": "St Paul College academic session, term configuration, and CA percentages",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string", "maxLength": 200 },
        "session": { "type": "string", "maxLength": 64 },
        "term": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["schoolName", "session", "term"]
    }
  },
  "firestore": {
    "/schools/{schoolId}/scores/{scoreId}": {
      "schema": "StudentScore",
      "description": "Continuous assessment and exam marks for every student, class, and subject"
    },
    "/schools/{schoolId}/students/{studentId}": {
      "schema": "Student",
      "description": "Complete student records including comments and scores"
    },
    "/schools/{schoolId}/settings/{settingId}": {
      "schema": "SchoolSetting",
      "description": "School settings and assessment percentage configurations"
    }
  }
}
